{
  "name": "ooca-letters-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist-api/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "mysql2": "^3.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "tsx": "^4.19.3",
    "vite": "^8.3.0"
  }
}
